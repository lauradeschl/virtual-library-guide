# Supabase project settings (Project Settings → API).
# The anon key is public by design; row-level security protects the table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Books API key (Google Cloud → APIs & Services → Credentials).
# Public in the browser; restrict it to the Books API and our domains.
VITE_GOOGLE_BOOKS_KEY=
